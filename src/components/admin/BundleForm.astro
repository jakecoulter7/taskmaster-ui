---
// Create / edit a shop bundle: several items sold together for one price.
// Only items sold directly in the shop can go in (no egg exclusives or
// skill tree rewards). The id is fixed once created.
import AdminField from "./AdminField.astro";
import Notice from "./Notice.astro";
import SlugFromName from "./SlugFromName.astro";
import { btnGhost, btnPrimary, labelClass } from "./styles";
import { CATEGORY_INFO, SHOP_CATEGORIES } from "../../data/coins";
import type { ShopItemRecord } from "../../data/admin";
import {
  BUNDLE_MAX_ITEMS,
  type FieldErrors,
  type FormValues,
} from "../../lib/admin-forms";
import { withBase } from "../../lib/url";

interface Props {
  mode: "create" | "edit";
  values: FormValues;
  /** The shop catalogue to pick from. */
  items: ShopItemRecord[];
  errors?: FieldErrors;
  formError?: string;
}

const { mode, values, items, errors = {}, formError } = Astro.props;
const isCreate = mode === "create";
const picked = new Set((values.itemIds ?? "").split(",").filter(Boolean));
const groups = SHOP_CATEGORIES.map((category) => ({
  category,
  label: CATEGORY_INFO[category].label,
  items: items.filter(
    (item) =>
      item.category === category && !item.crateOnly && !item.skillOnly,
  ),
})).filter((group) => group.items.length > 0);
---

<form method="post" class="space-y-6" novalidate data-slug-form>
  {formError && <Notice tone="error">{formError}</Notice>}

  <div class="grid gap-5 sm:grid-cols-2">
    <AdminField
      label="name"
      name="name"
      value={values.name}
      error={errors.name}
      attrs={{ "data-slug-source": "" }}
      required
    />
    {
      isCreate ? (
        <AdminField
          label="id"
          name="id"
          value={values.id}
          error={errors.id}
          hint="Lowercase, dash-separated. Fixed once created."
          attrs={{ "data-slug-target": "" }}
          required
        />
      ) : (
        <input type="hidden" name="id" value={values.id} />
      )
    }
  </div>
  <AdminField
    label="description"
    name="description"
    value={values.description}
    error={errors.description}
    rows={2}
    hint="Optional. Shown on the bundle's card."
  />

  <div class="grid gap-5 sm:grid-cols-2">
    <AdminField
      label="price"
      name="price"
      type="number"
      value={values.price}
      error={errors.price}
      hint="What the whole bundle costs. The shop shows the saving against buying each item."
      required
    />
    <AdminField
      label="sort order"
      name="sortOrder"
      type="number"
      value={values.sortOrder}
      error={errors.sortOrder}
      hint="Lower comes first. Blank keeps it where it is."
    />
  </div>

  <fieldset
    class="rounded-md border border-grid p-4"
    aria-describedby={errors.itemIds ? "field-itemIds-error" : undefined}
  >
    <legend class:list={[labelClass, "px-1"]}>
      items (2–{BUNDLE_MAX_ITEMS})
    </legend>
    <p class="text-xs text-ink-faint">
      One power-up of each kind at most. Players who've had any of these can't
      buy the bundle.
    </p>
    <div class="mt-3 grid gap-5 sm:grid-cols-2">
      {
        groups.map((group) => (
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-ink-faint">
              {group.label}
            </p>
            <ul class="mt-2 space-y-1">
              {group.items.map((item) => (
                <li>
                  <label class="flex items-center gap-2 text-sm text-ink">
                    <input
                      type="checkbox"
                      name="itemIds"
                      value={item.id}
                      checked={picked.has(item.id)}
                      class="accent-acid"
                    />
                    <span class="min-w-0 truncate">{item.name}</span>
                    <span class="text-xs text-amber tabular-nums">
                      {item.price}
                    </span>
                    {!item.available && (
                      <span class="text-[10px] font-bold uppercase tracking-widest text-ink-faint">
                        retired
                      </span>
                    )}
                  </label>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    {
      errors.itemIds && (
        <p id="field-itemIds-error" class="mt-3 text-xs text-danger">
          <span aria-hidden="true">✗ </span>
          {errors.itemIds}
        </p>
      )
    }
  </fieldset>

  <label class="flex items-center gap-3 text-sm text-ink">
    <input
      type="checkbox"
      name="available"
      checked={values.available === "on"}
      class="accent-acid"
    />
    for sale
    <span class="text-xs text-ink-faint">
      (shown on the shop's featured tab while the bundles flag is on)
    </span>
  </label>

  <div class="flex flex-wrap gap-3">
    <button type="submit" class={btnPrimary}>
      {isCreate ? "create bundle" : "save bundle"}
    </button>
    <a href={withBase("/admin/site#bundles")} class={btnGhost}>cancel</a>
  </div>
</form>
{isCreate && <SlugFromName />}
