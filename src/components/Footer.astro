---
// Footer styled as a terminal status/exit line.
import { withBase } from "../lib/url";

const year = new Date().getFullYear();
const aboutHref = withBase("/about");
const onAbout = Astro.url.pathname.startsWith(aboutHref);
---

<footer class="mt-16 border-t border-grid bg-term-bg/80">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p class="flex items-center gap-2">
      <span class="text-acid">$</span>
      <span>echo "EAYL Taskmaster &mdash; The Ultimate Academy Challenge"</span>
    </p>
    <nav aria-label="Footer" class="flex items-center gap-4">
      <a
        href={aboutHref}
        aria-current={onAbout ? "page" : undefined}
        class:list={[
          "group inline-flex items-center gap-1 tracking-wide transition-colors",
          onAbout ? "text-acid" : "text-ink-dim hover:text-ink",
        ]}
      >
        <span
          class:list={[
            onAbout ? "text-acid" : "text-ink-faint group-hover:text-acid",
          ]}
          aria-hidden="true"
        >
          ./
        </span>
        about
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle light / dark theme"
        class="group inline-flex items-center gap-1 tracking-wide text-ink-dim transition-colors hover:text-ink"
      >
        <span class="text-ink-faint group-hover:text-acid" aria-hidden="true"
          >$</span
        >
        theme
        <span data-theme-state class="text-ink-faint">--dark</span>
      </button>
    </nav>
    <p class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-dot-green"></span>
      <span
        >system nominal (for now) &middot; <a
          href={withBase("/about")}
          class="text-ink-faint underline-offset-2 transition-colors hover:text-acid hover:underline"
          >A Callum Mohan Production</a
        > &middot; &copy; {year}</span
      >
    </p>
  </div>
</footer>

<script>
  import {
    applyTheme,
    getActiveTheme,
    isTheme,
    THEME_CHANGE_EVENT,
    THEME_META_COLOR,
    type ThemeName,
  } from "../lib/theme";

  // The footer button is the quick dark/light switch; the exotic CRT
  // phosphor themes are summoned from the command palette. It reflects
  // whatever theme is active, including palette-triggered changes, by
  // listening for the shared theme-change event.
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  const stateLabels = document.querySelectorAll("[data-theme-state]");

  const reflectTheme = (theme: ThemeName) => {
    themeMeta?.setAttribute("content", THEME_META_COLOR[theme]);
    stateLabels.forEach((el) => {
      el.textContent = `--${theme}`;
    });
  };

  // Reflect whatever the pre-paint script already applied.
  reflectTheme(getActiveTheme());

  window.addEventListener(THEME_CHANGE_EVENT, (e) => {
    const theme = (e as CustomEvent<{ theme: ThemeName }>).detail?.theme;
    if (isTheme(theme)) reflectTheme(theme);
  });

  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      // Flips between the two standard themes; from an exotic phosphor theme
      // it returns to the plain light/dark pair.
      applyTheme(getActiveTheme() === "light" ? "dark" : "light");
    });
  });
</script>
