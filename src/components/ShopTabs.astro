---
// The shop's tab bar: plain links (`?tab=…`), so it works without JS and
// each tab is its own cacheable page. The current tab is marked for
// assistive tech with `aria-current`.
import type { ShopTab } from "../types";
import { SHOP_TAB_INFO, shopHref } from "../lib/coin-ui";

interface Props {
  tabs: { tab: ShopTab; count?: number }[];
  active: ShopTab;
  id?: string;
  class?: string;
}

const { tabs, active, id, class: className } = Astro.props;
---

<nav
  id={id}
  aria-label="Shop sections"
  class:list={["border-b border-grid", className]}
>
  <ul class="-mb-px flex gap-1 overflow-x-auto">
    {
      tabs.map(({ tab, count }) => (
        <li class="shrink-0">
          <a
            href={shopHref(tab, {}, "shop-tabs")}
            aria-current={tab === active ? "page" : undefined}
            class:list={[
              "inline-flex items-center gap-2 border-b-2 px-3 py-2.5 text-xs font-bold tracking-widest transition-colors",
              tab === active
                ? "border-acid text-acid"
                : "border-transparent text-ink-dim hover:border-ink-faint hover:text-ink",
            ]}
          >
            {tab === active && (
              <span class="text-acid" aria-hidden="true">
                &gt;
              </span>
            )}
            {SHOP_TAB_INFO[tab].label}
            {count !== undefined && count > 0 && (
              <span class="rounded border border-grid px-1.5 text-[10px] font-normal text-ink-faint tabular-nums">
                {count}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
