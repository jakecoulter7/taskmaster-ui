---
// The picture for a shop item: the pixel image for pets and avatars, and a
// preview for cosmetics and power-ups. Decorative: the item's name is always
// shown alongside it.
import type {
  AvatarFrame,
  NameColour,
  ProfileTheme,
  ShopItem,
} from "../types";
import {
  AVATAR_FRAMES,
  NAME_COLOURS,
  PROFILE_THEMES,
  renderShellPrompt,
} from "../data/coin-rules";
import {
  AVATAR_FRAME_INFO,
  NAME_COLOUR_CLASS,
  POWER_UP_GLYPH,
  PROFILE_THEME_INFO,
} from "../lib/coin-ui";
import { assetUrl } from "../lib/url";

interface Props {
  item: ShopItem;
  /** Sizing utilities for the square frame. */
  class?: string;
}

const { item, class: className = "h-16 w-16" } = Astro.props;

const value = item.cosmetic?.value;
const nameColour: NameColour | undefined = NAME_COLOURS.find(
  (c) => item.cosmetic?.kind === "name_colour" && c === value,
);
const theme: ProfileTheme | undefined = PROFILE_THEMES.find(
  (t) => item.cosmetic?.kind === "theme" && t === value,
);
const avatarFrame: AvatarFrame | undefined = AVATAR_FRAMES.find(
  (f) => item.cosmetic?.kind === "avatar_frame" && f === value,
);
const shellPrompt =
  item.cosmetic?.kind === "shell_prompt" ? item.cosmetic.value : undefined;
const frame =
  "flex shrink-0 items-center justify-center overflow-hidden rounded-md border border-grid bg-term-bg";
---

{
  item.imageUrl && (item.category === "pet" || item.category === "avatar") ? (
    <img
      src={assetUrl(item.imageUrl)}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width="64"
      height="64"
      class:list={[
        frame,
        "object-contain p-1 [image-rendering:pixelated]",
        className,
      ]}
    />
  ) : item.powerUp ? (
    <span
      aria-hidden="true"
      class:list={[
        frame,
        "text-2xl font-extrabold",
        POWER_UP_GLYPH[item.powerUp].class,
        className,
      ]}
    >
      {POWER_UP_GLYPH[item.powerUp].glyph}
    </span>
  ) : nameColour ? (
    <span
      aria-hidden="true"
      class:list={[
        frame,
        "text-xl font-extrabold",
        NAME_COLOUR_CLASS[nameColour],
        className,
      ]}
    >
      Aa
    </span>
  ) : avatarFrame ? (
    <span aria-hidden="true" class:list={[frame, "p-3", className]}>
      <span
        class:list={[
          "block h-full w-full rounded bg-term-panel-2",
          AVATAR_FRAME_INFO[avatarFrame].class,
        ]}
      ></span>
    </span>
  ) : shellPrompt ? (
    <span
      aria-hidden="true"
      class:list={[
        frame,
        "px-1 text-center text-[9px] font-bold leading-tight text-acid",
        className,
      ]}
    >
      <span class="line-clamp-3 [overflow-wrap:anywhere]">
        {renderShellPrompt(shellPrompt, "you")}
      </span>
    </span>
  ) : theme ? (
    <span aria-hidden="true" class:list={[frame, "p-2", className]}>
      <span
        class:list={[
          "flex h-full w-full items-center justify-center rounded border-2 text-xs font-bold",
          PROFILE_THEME_INFO[theme].swatch,
        ]}
      >
        &gt;_
      </span>
    </span>
  ) : (
    <span
      aria-hidden="true"
      class:list={[
        frame,
        "px-1 text-center text-[9px] font-bold leading-tight text-magenta",
        className,
      ]}
    >
      <span class="line-clamp-3 [overflow-wrap:anywhere]">
        “{value ?? item.name}”
      </span>
    </span>
  )
}
