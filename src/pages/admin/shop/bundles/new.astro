---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import TerminalWindow from "../../../../components/TerminalWindow.astro";
import BundleForm from "../../../../components/admin/BundleForm.astro";
import { btnGhost } from "../../../../components/admin/styles";
import {
  createBundle,
  describeWriteError,
  listShopItems,
} from "../../../../data/admin";
import {
  parseBundleForm,
  type FieldErrors,
  type FormValues,
} from "../../../../lib/admin-forms";
import { withBase } from "../../../../lib/url";

// Fail closed if the middleware guard is ever bypassed.
if (!Astro.locals.admin) return Astro.redirect(withBase("/login"));

const items = await listShopItems();
let values: FormValues = { available: "on", price: "20" };
let errors: FieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  const parsed = parseBundleForm(await Astro.request.formData(), items);
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    try {
      await createBundle(parsed.data);
      const query = new URLSearchParams({
        done: "saved",
        name: parsed.data.name,
      });
      return Astro.redirect(withBase(`/admin/site?${query}#bundles`));
    } catch (error) {
      formError = describeWriteError(error);
      if (!formError) throw error;
    }
  }
}
---

<AdminLayout title="New bundle">
  <a href={withBase("/admin/site#bundles")} class={btnGhost}>&larr; BUNDLES</a>
  <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-ink">
    <span class="text-acid">$</span> bundle add
  </h1>
  <TerminalWindow title="~/shop/bundles/new.bundle" class="mt-6">
    <BundleForm
      mode="create"
      values={values}
      items={items}
      errors={errors}
      formError={formError}
    />
  </TerminalWindow>
</AdminLayout>
