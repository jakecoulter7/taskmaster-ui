---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import CoinAmount from "../../components/CoinAmount.astro";
import BountyStatusBadge from "../../components/BountyStatusBadge.astro";
import Notice from "../../components/admin/Notice.astro";
import AdminEditLink from "../../components/AdminEditLink.astro";
import {
  btnDanger,
  btnGhost,
  btnPrimary,
  inputClass,
  labelClass,
} from "../../components/admin/styles";
import { BOUNTY_NOTE_MAX } from "../../data/coin-rules";
import {
  describeBountyOutcome,
  isBountyOutcome,
} from "../../lib/account-forms";
import { timeLeftLabel } from "../../lib/coin-ui";
import { ukDateFormat } from "../../lib/time";
import { withBase } from "../../lib/url";
import type { BountyClaimBlock } from "../../types";

const [queries, viewer] = await Promise.all([
  Astro.locals.getQueries(),
  Astro.locals.getViewer(),
]);
const { bountiesEnabled, getBounty } = queries;
if (!bountiesEnabled) return Astro.rewrite("/404");

const id = Number(Astro.params.id);
const detail = Number.isSafeInteger(id)
  ? getBounty(id, viewer?.playerId)
  : undefined;
if (!detail) return Astro.rewrite("/404");

const { view, isPoster, claimBlocked, myClaim, canAward, canCancel } = detail;
const { bounty, poster, winner, status, expiresAt, claims } = view;

const outcomeParam = Astro.url.searchParams.get("bounty") ?? "";
const notice = isBountyOutcome(outcomeParam)
  ? describeBountyOutcome(outcomeParam)
  : undefined;

const BLOCK_LABEL: Record<Exclude<BountyClaimBlock, "guest">, string> = {
  disabled: "bounties are switched off",
  "season-closed": "the season's over",
  closed: "this bounty is settled",
  "own-bounty": "this is your bounty",
};
const action = withBase("/account/bounties");
const loginHref = withBase(
  `/login?${new URLSearchParams({ next: `/bounties/${bounty.id}` })}`,
);
const dateFmt = ukDateFormat({
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
});
---

<Layout
  title={`${bounty.title} · bounty`}
  description={`A ${bounty.reward} Clim Coin bounty on the EAYL Taskmaster bounty board.`}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <nav aria-label="Breadcrumb" class="text-xs text-ink-faint">
      <a href={withBase("/bounties")} class="text-cyan hover:underline"
        >← bounty board</a
      >
    </nav>

    {
      notice && (
        <Notice tone={notice.tone} class="mt-6">
          {notice.message}
        </Notice>
      )
    }

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_22rem]">
      <div class="flex min-w-0 flex-col gap-8">
        <TerminalWindow
          title={`~/bounties/bounty-${bounty.id}.md`}
          meta={status === "open" ? timeLeftLabel(expiresAt) : undefined}
        >
          <div class="p-5">
            <div class="flex flex-wrap items-center gap-2">
              <BountyStatusBadge status={status} />
              <CoinAmount amount={bounty.reward} class="text-amber" />
            </div>
            <h1
              class="mt-3 text-3xl font-extrabold tracking-tight text-ink break-words"
            >
              {bounty.title}
            </h1>
            {
              bounty.details && (
                <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-dim">
                  {bounty.details}
                </p>
              )
            }
            <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-xs">
              <dt class="text-ink-faint">posted by</dt>
              <dd>
                <a
                  href={withBase(`/players/${poster.id}`)}
                  class="text-cyan hover:underline">{poster.name}</a
                >
              </dd>
              <dt class="text-ink-faint">posted</dt>
              <dd class="text-ink-dim">
                <time datetime={bounty.at}
                  >{dateFmt.format(new Date(bounty.at))}</time
                >
              </dd>
              {
                status === "open" && (
                  <>
                    <dt class="text-ink-faint">lapses</dt>
                    <dd class="text-ink-dim">
                      <time datetime={expiresAt}>
                        {dateFmt.format(new Date(expiresAt))}
                      </time>
                    </dd>
                  </>
                )
              }
              {
                winner && (
                  <>
                    <dt class="text-ink-faint">won by</dt>
                    <dd>
                      <a
                        href={withBase(`/players/${winner.id}`)}
                        class="text-cyan hover:underline"
                      >
                        {winner.name}
                      </a>
                    </dd>
                  </>
                )
              }
              {
                bounty.resolvedByName && (
                  <>
                    <dt class="text-ink-faint">settled</dt>
                    <dd class="text-ink-dim">by the Taskmaster</dd>
                  </>
                )
              }
            </dl>
            {
              viewer?.isAdmin && (
                <AdminEditLink
                  href="/admin/market#bounties"
                  subject="this bounty"
                  class="mt-4"
                />
              )
            }
          </div>
        </TerminalWindow>

        <section aria-labelledby="claims-heading">
          <p class="prompt text-[11px] text-ink-faint">
            cat ./bounties/bounty-{bounty.id}/claims
          </p>
          <h2 id="claims-heading" class="mt-1 text-xl font-extrabold text-ink">
            Claims <span class="text-ink-faint">({claims.length})</span>
          </h2>
          {
            claims.length === 0 ? (
              <p class="mt-4 text-sm text-ink-faint">nobody's claimed it yet.</p>
            ) : (
              <ul class="mt-4 divide-y divide-grid/60 rounded-lg border border-grid bg-term-panel/60 px-4">
                {claims.map(({ claim, player }) => (
                  <li class="flex flex-wrap items-start justify-between gap-3 py-3 text-sm">
                    <div class="min-w-0">
                      <a
                        href={withBase(`/players/${player.id}`)}
                        class="font-bold text-ink hover:text-acid"
                      >
                        {player.name}
                      </a>
                      {winner?.id === player.id && (
                        <span class="ml-2 text-[10px] font-bold tracking-[0.2em] text-amber">
                          WINNER
                        </span>
                      )}
                      {claim.note && (
                        <p class="mt-1 whitespace-pre-line break-words text-xs text-ink-dim">
                          {claim.note}
                        </p>
                      )}
                    </div>
                    {canAward && (
                      <form method="post" action={action}>
                        <input type="hidden" name="intent" value="award" />
                        <input type="hidden" name="bountyId" value={bounty.id} />
                        <input type="hidden" name="winnerId" value={player.id} />
                        <button
                          type="submit"
                          class:list={[btnPrimary, "px-3 py-1"]}
                          aria-label={`Award the bounty to ${player.name}`}
                        >
                          award {bounty.reward}
                        </button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
            )
          }
        </section>
      </div>

      <aside aria-labelledby="act-heading" class="flex flex-col gap-6">
        <section class="rounded-lg border border-grid bg-term-panel/60 p-5">
          <h2
            id="act-heading"
            class="text-xs font-bold uppercase tracking-[0.2em] text-ink-faint"
          >
            {isPoster ? "Your bounty" : "Claim it"}
          </h2>
          {
            isPoster ? (
              status !== "open" ? (
                <p class="mt-3 text-sm text-ink-dim">This bounty is settled.</p>
              ) : (
                <>
                  <p class="mt-3 text-sm leading-relaxed text-ink-dim">
                    {canAward
                      ? "Pick the winner from the claims. The reward moves to them straight away."
                      : "Nobody's claimed it yet. You can take it down until someone does."}
                  </p>
                  {canCancel && (
                    <form method="post" action={action} class="mt-4">
                      <input type="hidden" name="intent" value="cancel" />
                      <input type="hidden" name="bountyId" value={bounty.id} />
                      <button type="submit" class:list={[btnDanger, "w-full"]}>
                        take it down
                      </button>
                    </form>
                  )}
                </>
              )
            ) : claimBlocked === "guest" ? (
              viewer ? (
                <p class="mt-3 text-sm text-ink-dim">
                  Only this season's players can claim bounties.
                </p>
              ) : (
                <a href={loginHref} class:list={[btnGhost, "mt-4 w-full"]}>
                  sign in to claim →
                </a>
              )
            ) : claimBlocked ? (
              <p class="mt-3 text-sm text-ink-dim">
                <span class="text-cyan" aria-hidden="true">
                  &gt;{" "}
                </span>
                {BLOCK_LABEL[claimBlocked]}.
              </p>
            ) : (
              <>
                <form method="post" action={action} class="mt-4 space-y-3">
                  <input type="hidden" name="intent" value="claim" />
                  <input type="hidden" name="bountyId" value={bounty.id} />
                  <div>
                    <label for="claim-note" class={labelClass}>
                      how you did it (optional)
                    </label>
                    <textarea
                      id="claim-note"
                      name="note"
                      rows="3"
                      maxlength={BOUNTY_NOTE_MAX}
                      placeholder="A link, or a line on how you pulled it off."
                      class:list={[inputClass(false), "mt-1"]}
                      set:text={myClaim?.note ?? ""}
                    />
                  </div>
                  <button type="submit" class:list={[btnPrimary, "w-full"]}>
                    {myClaim ? "update claim" : "claim bounty"}
                  </button>
                </form>
                {myClaim && (
                  <form method="post" action={action} class="mt-2">
                    <input type="hidden" name="intent" value="unclaim" />
                    <input type="hidden" name="bountyId" value={bounty.id} />
                    <button
                      type="submit"
                      class="w-full text-center text-xs text-cyan hover:underline"
                    >
                      withdraw your claim
                    </button>
                  </form>
                )}
              </>
            )
          }
        </section>
      </aside>
    </div>
  </div>
</Layout>
