---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import BountyCard from "../../components/BountyCard.astro";
import CoinAmount from "../../components/CoinAmount.astro";
import Pagination from "../../components/Pagination.astro";
import Notice from "../../components/admin/Notice.astro";
import {
  btnGhost,
  btnPrimary,
  inputClass,
  labelClass,
} from "../../components/admin/styles";
import {
  BOUNTY_DAYS,
  BOUNTY_DETAILS_MAX,
  BOUNTY_OPEN_LIMIT,
  BOUNTY_REWARD_RANGE,
  BOUNTY_TITLE_MAX,
} from "../../data/coin-rules";
import {
  describeBountyOutcome,
  isBountyOutcome,
} from "../../lib/account-forms";
import {
  GALLERY_PAGE_SIZE,
  LIST_PAGE_SIZE,
  pageHref,
  paginate,
  parsePage,
} from "../../lib/pagination";
import { withBase } from "../../lib/url";
import type { BountyPostBlock } from "../../types";

const [queries, viewer] = await Promise.all([
  Astro.locals.getQueries(),
  Astro.locals.getViewer(),
]);
const { season, bountiesEnabled, getBountyBoard, getBountyPostPanel } =
  queries;
// Behind the bounties feature flag (/admin/site#flags).
if (!bountiesEnabled) return Astro.rewrite("/404");

const board = getBountyBoard();
const panel = getBountyPostPanel(viewer?.playerId);
const params = Astro.url.searchParams;
const openPage = paginate(
  board.open,
  parsePage(params.get("page")),
  GALLERY_PAGE_SIZE,
);
const settledPage = paginate(
  board.settled,
  parsePage(params.get("settled")),
  LIST_PAGE_SIZE,
);

const outcomeParam = params.get("bounty") ?? "";
const notice = isBountyOutcome(outcomeParam)
  ? describeBountyOutcome(outcomeParam)
  : undefined;

const BLOCK_LABEL: Record<Exclude<BountyPostBlock, "guest">, string> = {
  disabled: "bounties are switched off",
  "season-closed": "the season's over",
  limit: `you have ${BOUNTY_OPEN_LIMIT} open bounties already; settle one first`,
  unaffordable: "you need at least 1 Clim Coin to spare",
};
const maxReward = Math.max(
  BOUNTY_REWARD_RANGE.min,
  Math.min(BOUNTY_REWARD_RANGE.max, panel.available ?? 0),
);
const action = withBase("/account/bounties");
const loginHref = withBase(
  `/login?${new URLSearchParams({ next: "/bounties" })}`,
);
---

<Layout
  title="Bounties"
  description="Clim Coin bounties: EAYL Taskmaster players put up coins for a challenge, and whoever pulls it off wins them."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <header>
      <p
        class="prompt text-xs font-bold uppercase tracking-[0.3em] text-ink-dim"
      >
        ./bounties --open
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl"
      >
        THE <span class="text-magenta">BOUNTY</span> BOARD
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-dim">
        <span class="text-acid">//</span> Players put up Clim Coin for a challenge.
        Do it, claim it, and if the poster picks you the coins are yours. Rewards
        are held from the poster's wallet while a bounty's open; anything still unawarded
        after {BOUNTY_DAYS} days lapses and the coins go back. {season.name} players
        only.
      </p>
    </header>

    {
      notice && (
        <Notice tone={notice.tone} class="mt-6">
          {notice.message}
        </Notice>
      )
    }

    <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_22rem]">
      <section
        id="open"
        aria-labelledby="open-heading"
        class="min-w-0 scroll-mt-24"
      >
        <p class="prompt text-[11px] text-ink-faint">
          ls ./bounties --open --sort reward
        </p>
        <h2 id="open-heading" class="mt-1 text-xl font-extrabold text-ink">
          Up for grabs <span class="text-ink-faint">({board.open.length})</span>
        </h2>
        {
          openPage.items.length === 0 ? (
            <p class="mt-6 rounded-lg border border-dashed border-grid p-6 text-sm text-ink-faint">
              <span class="text-cyan" aria-hidden="true">
                &gt;{" "}
              </span>
              no open bounties right now.
              {!panel.blocked && " Be the first to post one."}
            </p>
          ) : (
            <ul class="mt-6 grid gap-4 sm:grid-cols-2">
              {openPage.items.map((view) => (
                <li class="flex">
                  <BountyCard view={view} class="w-full" />
                </li>
              ))}
            </ul>
          )
        }
        <Pagination
          info={openPage}
          href={(n) =>
            pageHref(Astro.url, "page", n, {
              hash: "open",
              drop: ["bounty"],
            })}
          label="Open bounty pages"
          itemLabel="bounties"
          class="mt-6"
        />
      </section>

      <aside aria-labelledby="post-heading" class="flex flex-col gap-6">
        <TerminalWindow title="~/bounties/new">
          <div class="p-5">
            <h2
              id="post-heading"
              class="text-xs font-bold uppercase tracking-[0.2em] text-ink-faint"
            >
              Post a bounty
            </h2>
            {
              panel.blocked === "guest" ? (
                <>
                  <p class="mt-3 text-sm leading-relaxed text-ink-dim">
                    {viewer
                      ? `Only ${season.name} players can post bounties.`
                      : "Sign in as a player to post or claim bounties."}
                  </p>
                  {!viewer && (
                    <a href={loginHref} class:list={[btnGhost, "mt-4 w-full"]}>
                      sign in →
                    </a>
                  )}
                </>
              ) : (
                <>
                  <p class="mt-2 text-[11px] text-ink-faint">
                    you can spend{" "}
                    <CoinAmount
                      amount={panel.available ?? 0}
                      class="text-amber"
                    />{" "}
                    · {panel.openCount}/{BOUNTY_OPEN_LIMIT} open
                  </p>
                  {panel.blocked ? (
                    <p class="mt-3 text-sm text-ink-dim">
                      <span class="text-cyan" aria-hidden="true">
                        &gt;{" "}
                      </span>
                      {BLOCK_LABEL[panel.blocked]}.
                    </p>
                  ) : (
                    <form method="post" action={action} class="mt-4 space-y-3">
                      <input type="hidden" name="intent" value="post" />
                      <div>
                        <label for="bounty-title" class={labelClass}>
                          the challenge
                        </label>
                        <input
                          id="bounty-title"
                          name="title"
                          required
                          maxlength={BOUNTY_TITLE_MAX}
                          placeholder="e.g. Get a selfie with the CTO"
                          class:list={[inputClass(false), "mt-1"]}
                        />
                      </div>
                      <div>
                        <label for="bounty-details" class={labelClass}>
                          details (optional)
                        </label>
                        <textarea
                          id="bounty-details"
                          name="details"
                          rows="3"
                          maxlength={BOUNTY_DETAILS_MAX}
                          placeholder="What counts, and how to prove it."
                          class:list={[inputClass(false), "mt-1"]}
                        />
                      </div>
                      <div>
                        <label for="bounty-reward" class={labelClass}>
                          reward ({BOUNTY_REWARD_RANGE.min}–{maxReward})
                        </label>
                        <input
                          id="bounty-reward"
                          name="reward"
                          type="number"
                          inputmode="numeric"
                          required
                          min={BOUNTY_REWARD_RANGE.min}
                          max={maxReward}
                          value={Math.min(5, maxReward)}
                          class:list={[inputClass(false), "mt-1"]}
                        />
                      </div>
                      <p class="text-[11px] leading-relaxed text-ink-faint">
                        The reward is held from your wallet until you pick a
                        winner, take it down (only before anyone claims it) or
                        it lapses after {BOUNTY_DAYS} days.
                      </p>
                      <button type="submit" class:list={[btnPrimary, "w-full"]}>
                        post bounty
                      </button>
                    </form>
                  )}
                </>
              )
            }
          </div>
        </TerminalWindow>
      </aside>
    </div>

    <section
      id="settled"
      aria-labelledby="settled-heading"
      class="mt-14 scroll-mt-24"
    >
      <p class="prompt text-[11px] text-ink-faint">tail ./bounties/settled.log</p>
      <h2 id="settled-heading" class="mt-1 text-xl font-extrabold text-ink">
        Settled
      </h2>
      {
        settledPage.items.length === 0 ? (
          <p class="mt-4 text-sm text-ink-faint">nothing settled yet.</p>
        ) : (
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {settledPage.items.map((view) => (
              <li class="flex">
                <BountyCard view={view} showStatus class="w-full" />
              </li>
            ))}
          </ul>
        )
      }
      <Pagination
        info={settledPage}
        href={(n) =>
          pageHref(Astro.url, "settled", n, {
            hash: "settled",
            drop: ["bounty"],
          })}
        label="Settled bounty pages"
        itemLabel="bounties"
        class="mt-4"
      />
    </section>
  </div>
</Layout>
